{
  "name": "queueflow-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "shared"
  ],
  "scripts": {
    "build": "npm run --workspaces build",
    "test": "vitest run",
    "db:generate": "npm run db:generate --workspace=@queueflow/database"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
